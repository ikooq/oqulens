# ИИ-ассистент и ИИ-записка (необязательно — без ключа работают автоматическая записка
# и готовые ответы ассистента). Достаточно ОДНОГО ключа:

# Бесплатно, без карты: ключ Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Модель Groq (необязательно), по умолчанию openai/gpt-oss-120b;
# при упоре в лимит — qwen/qwen3.8-27b, затем openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b

# Бесплатно: ключ Google Gemini — https://aistudio.google.com/apikey
# (бесплатный тариф доступен не для всех аккаунтов Google)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Платно: ключ Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Порядок по умолчанию: Claude → Groq → Gemini. Чтобы выбрать явно:
# AI_PROVIDER=groq
